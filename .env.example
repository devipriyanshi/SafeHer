# SafeHer Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=SafeHer
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key-minimum-32-chars

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/safeher.db

# Email (optional — leave blank to use MockNotifier)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS (optional — leave blank to use MockNotifier)
SMS_API_KEY=
SMS_SENDER_ID=

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
